# ════════════════════════════════════════════════
# ADH — Adıyaman Dijital Haber — Production Config (K08/K09)
# ════════════════════════════════════════════════
# Bu dosya production ortamı için gerekli env değişkenlerini örneklendirir.
# Dosyayı .env olarak kopyala ve değerleri doldur.
# ASLA bu dosyayı gizli anahtarlar veya gerçek şifrelerle commit'leme.

# ── Uygulama ──
APP_NAME="Adıyaman Dijital Haber"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://adiyamandijitalhaber.com.tr
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# ── Veritabanı ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adh_production
DB_USERNAME=
DB_PASSWORD=

# ── Cache & Session & Queue ──
CACHE_STORE=file
SCHEDULE_CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
DB_QUEUE=default

# ── Posta ──
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@adiyamandijitalhaber.com.tr
MAIL_FROM_NAME="${APP_NAME}"

# ── Dosya depolama ──
FILESYSTEM_DISK=public

# ── Proxy (Cloudflare) — K34 ──
TRUSTED_PROXIES=*

# ── Sentry (isteğe bağlı) ──
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

VITE_APP_NAME="${APP_NAME}"

# ── IHA Haber Ajansı ──
IHA_API_URL=https://abonerss.iha.com.tr/xml/standartrss
IHA_USER_CODE=
IHA_USERNAME=
IHA_PASSWORD=
IHA_SYNC_INTERVAL=15
IHA_REQUEST_DELAY=1
IHA_MIN_BODY_LENGTH=280
IHA_VERIFY_SSL=true
IHA_RETRY_ATTEMPTS=3
IHA_RETRY_DELAY=60
IHA_IMAGE_DISK=public
IHA_IMAGE_PATH=news-images

# ── Hava durumu (Open-Meteo) ──
WEATHER_PROVIDER=open-meteo
WEATHER_CITY=Adiyaman
WEATHER_LAT=37.76
WEATHER_LON=38.28
WEATHER_CACHE_MINUTES=30

# ── Nöbetçi eczane (NosyAPI) ──
PHARMACY_API_URL=https://api.nosyapi.com/apiv2/pharmacy
PHARMACY_API_KEY=
PHARMACY_CITY=adiyaman
PHARMACY_CACHE_HOURS=24

# ── Namaz vakitleri (Aladhan) ──
PRAYER_PROVIDER=aladhan
PRAYER_LAT=37.76
PRAYER_LON=38.28
PRAYER_METHOD=13
PRAYER_CACHE_HOURS=24

# ── Instagram ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_ENABLED=false

# ── Google AdSense ──
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false

# ── Google Analytics / Search Console ──
# Admin panelden de girilebilir
GOOGLE_ANALYTICS_ID=G-WRTKSNRSBR

# ── Log ──
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_LEVEL=warning

# Optional integrations
GOOGLE_TRANSLATE_API_KEY=

# Live project convention: IHA_REQUEST_DELAY should remain 1 unless the provider asks otherwise.
