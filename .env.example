# ── Uygulama ────────────────────────────────────────────────────────────────
APP_NAME="Adıyaman Dijital Haber"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost
# Canlı: APP_URL=https://adiyamandijitalhaber.com.tr (alan adı)

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── Loglama ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Veritabanı ───────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haber_sitesi
DB_USERNAME=root
DB_PASSWORD=

# ── Oturum & Önbellek ─────────────────────────────────────────────────────────
# Yerelde varsayılan config/session.php: file (DB gerekmez). Prod’da cluster için database kullanılabilir.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# ── Oturum güvenliği (production: SESSION_SECURE_COOKIE=true; local + http için false — aksi halde Filament 419) ──────────────
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE=default

CACHE_STORE=file
SCHEDULE_CACHE_STORE=file
CACHE_PREFIX=adh_

# ── Proxy (Cloudflare / load balancer) ───────────────────────────────────────
# Production/staging behind TLS termination: set to * or real proxy IPs (see Cloudflare IP ranges).
# Local (APP_ENV=local): leave unset or empty — wildcard here can cause Filament 419 on http://.
# TRUSTED_PROXIES=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Posta ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@adiyamandijitalhaber.com.tr"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (isteğe bağlı) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── IHA Haber Ajansı ─────────────────────────────────────────────────────────
IHA_API_URL=https://abonerss.iha.com.tr/xml/standartrss
IHA_USER_CODE=
IHA_USERNAME=
IHA_PASSWORD=
IHA_SYNC_INTERVAL=15
IHA_REQUEST_DELAY=1
IHA_MIN_BODY_LENGTH=280
IHA_VERIFY_SSL=true
IHA_RETRY_ATTEMPTS=3
IHA_RETRY_DELAY=60
IHA_IMAGE_DISK=public
IHA_IMAGE_PATH=news-images

# ── Hava Durumu (Open-Meteo — API key gerektirmez) ──────────────────────────
WEATHER_PROVIDER=open-meteo
WEATHER_CITY=Adiyaman
WEATHER_LAT=37.76
WEATHER_LON=38.28
WEATHER_CACHE_MINUTES=30
# OpenWeatherMap'e geçilecekse:
# WEATHER_PROVIDER=openweathermap
# OPENWEATHER_API_KEY=your_key_here

# ── Nöbetçi Eczane (NosyAPI) ─────────────────────────────────────────────────
PHARMACY_API_URL=https://api.nosyapi.com/apiv2/pharmacy
PHARMACY_API_KEY=
PHARMACY_CITY=adiyaman
PHARMACY_CACHE_HOURS=24

# ── Namaz Vakitleri (Aladhan — API key gerektirmez) ──────────────────────────
PRAYER_PROVIDER=aladhan
PRAYER_LAT=37.76
PRAYER_LON=38.28
PRAYER_METHOD=13
PRAYER_CACHE_HOURS=24
# Diyanet API'ye geçilecekse:
# PRAYER_PROVIDER=diyanet
# DIYANET_API_URL=https://...

# ── Instagram Graph API ───────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_ENABLED=false

# ── Google AdSense ───────────────────────────────────────────────────────────
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false

# ── Google Analytics (GA4 ölçüm kimliği) ─────────────────────────────────────
GOOGLE_ANALYTICS_ID=G-WRTKSNRSBR

# ── Google Translate ─────────────────────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=
